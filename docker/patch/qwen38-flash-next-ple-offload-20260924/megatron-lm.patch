+    rq, rk, rv = (x.detach().clone().requires_grad_() for x in (q, k, v))
+    expected = _dense_reference(rq, rk, rv, mask, dim**-0.5)
+    torch.testing.assert_close(out.float(), expected.float(), atol=7e-2, rtol=7e-2)
+    grad = torch.randn_like(out)
