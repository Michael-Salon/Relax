+        torch.testing.assert_close(sparse[0].float(), dense[0].float(), atol=7e-2, rtol=7e-2)
+        for label, actual, reference in zip(("hidden", "qkv_weight"), sparse[1], dense[1]):
+            difference = (actual.float() - reference.float()).abs()
