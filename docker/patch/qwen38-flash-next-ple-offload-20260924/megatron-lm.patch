+    assert toy["key_weight"].grad is not None
+    assert toy["key_weight"].grad.abs().sum() > 0
+    assert toy["hidden"].grad is None
+    assert toy["teacher_query"].grad is None
+    assert toy["teacher_key"].grad is None
