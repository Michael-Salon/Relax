+    _stage2_packed_lengths(packed, total_tokens=32, device=cu.device)
+    if in_place:
+        cu[1] = 15
+    else:
+        packed.cu_seqlens_q = cu.clone()
+    with pytest.raises(ValueError, match="device cu_seqlens changed"):
+        _stage2_packed_lengths(packed, total_tokens=32, device=cu.device)
