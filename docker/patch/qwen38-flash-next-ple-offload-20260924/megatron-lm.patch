+            .cuda()
+            .eval()
+        )
+        total = 2064
+        cu = torch.tensor([0, 2056, total], dtype=torch.int32, device="cuda")
+        packed_params = PackedSeqParams(
+            qkv_format="thd",
+            cu_seqlens_q=cu,
+            cu_seqlens_kv=cu,
