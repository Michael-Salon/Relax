+    positions = torch.arange(seq_len, device="cuda", dtype=torch.int32).unsqueeze(0)
+    visible = (positions + 1) // ratio
+    slot = torch.arange(topk, device="cuda", dtype=torch.int32)
+    candidate = visible.unsqueeze(-1) - slot - 1
