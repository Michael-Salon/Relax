+    "layer_types": ["linear_attention", "linear_attention", "linear_attention", "full_attention"],
+    "hc_count": 4,
+    "hc_lowrank": 8,
+    "ple_layer_ids": [2],
+    "ple_embed_dim": 64,
+    "ple_conv_kernel_size": 4,
+    "ngram_size": 3,
